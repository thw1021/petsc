  interface
    subroutine DMPlexRestoreCone(a,b,c, z)
    import tDM
    DM :: a
    PetscInt :: b
    PetscInt, pointer :: c(:)
    PetscErrorCode z
    end subroutine

    subroutine DMPlexRestoreSupport(a,b,c, z)
    import tDM
    DM :: a
    PetscInt :: b
    PetscInt, pointer :: c(:)
    PetscErrorCode z
    end subroutine

    subroutine DMPlexRestoreFullMeet(a,b,c,d,e, z)
    import tDM
    DM :: a
    PetscInt :: b
    PetscInt :: c(*)
    PetscInt :: d
    PetscInt, pointer :: e(:)
    PetscErrorCode z
    end subroutine
  end interface
