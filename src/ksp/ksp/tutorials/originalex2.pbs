#aprun -j 1 -n $MYN -N 24  ./originalex2 -ksp_type cgs  -pc_type jacobi -m $MYM  -n $MYS
#aprun -j 1 -n $MYN -N 24  ./originalex2 -ksp_type cgs  -pc_type jacobi -m $MYM  -n $MYS
