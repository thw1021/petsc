    x subsolver:
      Tao Object: (admm_sub_0_) 1 MPI process
        type: nls
        Objective function:
          TaoTerm Object: (admm_sub_0_) 1 MPI process
            type: sum
            solution vector space: N = 13
            parameter vector space: K = 17
