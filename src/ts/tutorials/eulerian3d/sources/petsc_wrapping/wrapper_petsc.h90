interface
    subroutine PetscFVSetComponentName(fvm, comp, name, ierr)
        use petscdmdef
        PetscFV :: fvm
        PetscInt, intent(in) :: comp
        character(len=*) :: name
        PetscErrorCode, intent(out) :: ierr
    end subroutine PetscFVSetComponentName

    subroutine PetscFVView(fvm, vin, ierr)
        use petscdmdef
        PetscFV :: fvm
        PetscViewer :: vin
        PetscErrorCode, intent(out) :: ierr
    end subroutine PetscFVView

    subroutine PetscFVSetType(fvm, typename, ierr)
        use petscdmdef
        PetscFV :: fvm
        character(len=*) :: typename
        PetscErrorCode, intent(out) :: ierr
    end subroutine PetscFVSetType

    subroutine PetscDSView(prob, vin, ierr)
        use petscdmdef
        PetscDS :: prob
        PetscViewer :: vin
        PetscErrorCode, intent(out) :: ierr
    end subroutine PetscDSView

    subroutine DMPlexTSComputeBoundary(dm, time, locX, locX_t, user, ierr)
        use petsctsdef
        DM :: dm
        PetscReal :: time
        Vec :: locX, locX_t
        PetscScalar, dimension(:) :: user
        PetscErrorCode, intent(out) :: ierr
    end subroutine DMPlexTSComputeBoundary

    subroutine DMPlexTSComputeRHSFunctionFVM(dm, time, locX, F, user, ierr)
        use petsctsdef
        DM :: dm
        PetscReal :: time
        Vec :: locX, F
        PetscScalar, dimension(:) :: user
        PetscErrorCode, intent(out) :: ierr
    end subroutine DMPlexTSComputeRHSFunctionFVM
end interface