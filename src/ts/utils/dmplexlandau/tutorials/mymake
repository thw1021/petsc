# make -f mymake runex1 FILE=sol-Q2-P1-A3-no-shift DT=.01 AMR=2,2 POST=1 ORDER=2 STEPS=1000000 TIME=20000 EXTRA='-options_left -dm_landau_thermal_temps .3,.2 -dm_landau_verbose 1 -ts_rtol 1e-2' | tee out-aniso-maxwellians-0-Q2-adaptive_tol2-refine3

runex1:
	-${PRE} ./ex1 ${PRE1} -petscspace_degree ${ORDER} -dm_landau_type ${FOREST} -dm_landau_num_species_grid 1,1 -dm_landau_ion_masses 2 -dm_landau_ion_charges 1 -dm_landau_thermal_temps .3,.2 -dm_landau_n 1,1  -ts_max_steps ${STEPS} -ts_dt ${DT} -ts_max_time ${TIME} -ts_adapt_monitor -dm_landau_amr_levels_max ${AMR},${AMR} -dm_landau_amr_post_refine ${POST} -dm_landau_amr_re_levels ${AMR2} -dm_landau_re_radius ${RERAD}  -dm_landau_domain_radius ${RAD},${RAD} ${EXTRA} -ex1_dm_view_e hdf5:${FILE}_e.h5 -ex1_vec_view_e hdf5:${FILE}_e.h5::append ${EXTRA} -ex1_dm_view_i hdf5:${FILE}_i.h5 -ex1_vec_view_i hdf5:${FILE}_i.h5::append 
	-@conda run ${PETSC_DIR}/lib/petsc/bin/petsc_gen_xdmf.py ${FILE}_e.h5
	-@conda run ${PETSC_DIR}/lib/petsc/bin/petsc_gen_xdmf.py ${FILE}_i.h5
# -dm_landau_electron_shift

xmf:
	-@conda run ${PETSC_DIR}/lib/petsc/bin/petsc_gen_xdmf.py ${FILE}_e.h5
	-@conda run ${PETSC_DIR}/lib/petsc/bin/petsc_gen_xdmf.py ${FILE}_i.h5

 runspit:
	-${PRE} ./ex2 ${PRE1} -dim ${DIM} -dm_landau_num_species_grid 1,1 -ex2_test_type spitzer -ex2_connor_e_field_units -dm_landau_Ez 0.05 -petscspace_degree ${ORDER} -dm_landau_type ${FOREST} -dm_landau_ion_masses 2 -dm_landau_ion_charges 1 -dm_landau_thermal_temps 1,1 -dm_landau_n 1,1 -ts_monitor -ts_adapt_monitor -snes_rtol ${RTOL} -snes_stol ${RTOL} -snes_monitor -snes_converged_reason -snes_max_it 25 -ts_type arkimex -ts_exact_final_time stepover -ts_arkimex_type 1bee -ts_max_snes_failures -1 -ts_rtol 1e-1 -ts_dt ${DT} -ts_adapt_clip .2,1.1 -ts_max_time 100 -ts_max_steps ${STEPS} -ts_adapt_scale_solve_failed 0.2 -ts_adapt_time_step_increase_delay 5 ${SOLV} -dm_landau_amr_levels_max ${AMR},${AMR} -dm_landau_amr_post_refine ${POST} -ex2_plot_dt ${DT} -dm_landau_device_type ${DEVICE}  ${MATVEC} -dm_landau_batch_view_idx ${BID} -ex2_grid_view_idx ${SP} -dm_landau_batch_size ${BSZ} ${EXTRA}

