      Interface  MatSetPreallocationCOO
        subroutine MatSetPreallocationCOO32(a,b,c,d,z)
         import tMat
         Mat a ! Mat
         integer4 b
         PetscInt c (*) ! PetscInt
         PetscInt d (*) ! PetscInt
         PetscErrorCode z
        end subroutine MatSetPreallocationCOO32
        subroutine MatSetPreallocationCOO64(a,b,c,d,z)
