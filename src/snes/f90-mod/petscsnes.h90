#if defined(PETSC_HAVE_FORTRAN_TYPE_STAR)
      Interface
      subroutine DMDASNESSetFunctionLocal(dm,imode,func,ctx,ierr)
      import tSNES,tDM
       DM, intent(in) :: dm
       InsertMode, intent(in) :: imode
       external :: func
       type(*) :: ctx
       PetscErrorCode, intent(out) :: ierr
      end subroutine DMDASNESSetFunctionLocal
      end Interface

      Interface
      subroutine DMSNESSetFunctionLocal(dm,func,ctx,ierr)
      import tSNES,tDM
       DM, intent(in) :: dm
       external :: func
       type(*)  :: ctx
       PetscErrorCode, intent(out) :: ierr
      end subroutine DMSNESSetFunctionLocal
      end Interface

      interface SNESSetJacobian
      subroutine SNESSetJacobian1(a,b,c,d,e,z)
       import tSNES, tMatFDColoring, tMat
       SNES a
       Mat b
       Mat c
       external d
       MatFDColoring e
       PetscErrorCode z
      end subroutine
      subroutine SNESSetJacobian2(a,b,c,d,e,z)
       import tSNES, tMatFDColoring, tMat
       SNES a
       Mat b
       Mat c
       external d
       integer e
       PetscErrorCode z
      end subroutine
      end interface

      Interface
      subroutine DMSNESSetJacobianLocal(dm,func,ctx,ierr)
      import tSNES,tDM
       DM, intent(in) :: dm
       external :: func
       type(*)  :: ctx
       PetscErrorCode, intent(out) :: ierr
      end subroutine DMSNESSetJacobianLocal
      end Interface

      Interface
      subroutine SNESSetConvergenceTest(snes,func,cctx,destroy,ierr)
      import tSNES
       SNES :: snes
       external :: func
       type(*) :: cctx
       external :: destroy
       PetscErrorCode, intent(out) :: ierr
      end subroutine
      end Interface
#endif

