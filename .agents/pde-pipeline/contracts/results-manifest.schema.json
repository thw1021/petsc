{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedsim/contracts/results-manifest.schema.json",
  "title": "Results Manifest",
  "description": "Inventory of what a simulation run produced. Emitted by code-generation to the orchestrator, which fans it out to visualization and numerical-analysis. Large data files are referenced by path, never inlined.",
  "type": "object",
  "required": ["schema_version", "id", "numerical_plan_id", "build", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string" },
    "numerical_plan_id": { "type": "string" },
    "vis_spec_id": { "type": "string" },
    "build": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["success", "failure"] },
        "compiler": { "type": "string" },
        "flags": { "type": "string" },
        "log_path": { "type": "string" }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "status", "output_files"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "description": "e.g. 'mms-level-3', 'production-Re1000'." },
          "command": { "type": "string" },
          "mpi_ranks": { "type": "integer" },
          "status": { "type": "string", "enum": ["success", "failure", "diverged", "timeout"] },
          "wall_time_s": { "type": "number" },
          "output_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "kind"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "kind": { "type": "string", "enum": ["solution", "checkpoint", "log", "convergence_data", "diagnostic", "other"] },
                "format": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "convergence_study": {
      "type": "object",
      "description": "Present when a refinement study was run.",
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["h"],
            "additionalProperties": false,
            "properties": {
              "h": { "type": "number", "description": "Representative mesh size / time step." },
              "dof": { "type": "integer" },
              "errors": { "type": "object", "additionalProperties": { "type": "number" }, "description": "norm -> error value." },
              "solver_iterations": { "type": "integer" }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "description": "Present only when code-generation could not reach a passing/usable result on its own and is handing back to the orchestrator. Machine-routable, symmetric with numerical-assessment.recommended_changes. A run that merely converged wrongly is NOT an escalation — return it normally for numerical-analysis to assess.",
      "required": ["suspected_cause", "target_agent", "summary", "attempts"],
      "additionalProperties": false,
      "properties": {
        "suspected_cause": { "type": "string", "enum": ["implementation", "plan", "model", "environment", "unknown"] },
        "target_agent": { "type": "string", "enum": ["code-generation", "numerical-analysis", "pde-modeling", "orchestrator"] },
        "summary": { "type": "string", "description": "What failed and the supporting evidence." },
        "attempts": { "type": "integer", "description": "Number of build/run fix attempts made before escalating." },
        "last_error": { "type": "string", "description": "The final persistent error message or symptom." }
      }
    },
    "notes": { "type": "string" }
  }
}
